# Copie para .env.local (desenvolvimento) ou para .env no servidor.
# Nunca coloque chaves reais neste arquivo.

# Endereço público do site, sem barra no final (usado em SEO, sitemap e Open Graph).
# Precisa existir no momento do build.
NEXT_PUBLIC_SITE_URL=https://yvtech.com.br

# ── Formulário de contato ──────────────────────────────────────────
# A mensagem é guardada no banco e avisada no WhatsApp e/ou por e-mail.
# Basta configurar um dos canais; com o banco, nenhuma mensagem se perde.

# Banco (PostgreSQL). No servidor, o docker-compose monta esta URL sozinho.
DATABASE_URL=postgresql://portfolio:SENHA@localhost:5432/portfolio

# Aviso no WhatsApp pela Evolution API (v2)
EVOLUTION_API_URL=https://evolution.seu-dominio.com.br
EVOLUTION_API_KEY=
# Nome da instância que envia o aviso
EVOLUTION_INSTANCE=
# Número que recebe o aviso: DDI + DDD + número, só dígitos (ex.: 5531999999999)
CONTACT_WHATSAPP_NUMBER=

# E-mail pelo Resend (opcional) — https://resend.com/docs/api-reference/emails/send-email
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfólio Yasmin <contato@seu-dominio.com.br>"
CONTACT_TO_EMAIL=yvitoriia.oliveira@gmail.com
