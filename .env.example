# Copie para .env.local (desenvolvimento) ou configure no painel da hospedagem.
# Nunca coloque chaves reais neste arquivo.

# Endereço público do site, sem barra no final (usado em SEO, sitemap e Open Graph).
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Formulário de contato — envio pelo Resend (https://resend.com/docs/api-reference/emails/send-email)
# 1. Crie a conta e gere uma chave em https://resend.com/api-keys
# 2. Verifique o domínio do remetente em https://resend.com/domains
RESEND_API_KEY=
# Remetente: precisa ser de um domínio verificado no Resend.
# Para testar sem domínio próprio, o Resend aceita "onboarding@resend.dev" (só envia para o e-mail da conta).
CONTACT_FROM_EMAIL="Portfólio Yasmin <contato@seu-dominio.com.br>"
# Quem recebe as mensagens.
CONTACT_TO_EMAIL=yvitoriia.oliveira@gmail.com
